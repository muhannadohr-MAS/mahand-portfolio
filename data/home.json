"\n<a class=\"skip-link\" href=\"#main\">\u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649</a>\n<header class=\"site-header\">\n <div class=\"container nav-wrap\">\n  <a class=\"brand\" href=\"#home\" aria-label=\"\u0645\u0647\u0646\u062f \u0633\u0644\u0627\u0645\u0629\u060c \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\"><img class=\"brand-logo\" src=\"/assets/brand-logo.jpg\" alt=\"\u0634\u0639\u0627\u0631 \u0645\u0647\u0646\u062f \u0633\u0644\u0627\u0645\u0629\"><span>\u0645\u0647\u0646\u062f \u0633\u0644\u0627\u0645\u0629<small>\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0647\u0646\u064a</small></span></a>\n  <nav aria-label=\"\u0627\u0644\u062a\u0646\u0642\u0644 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\" class=\"desktop-nav\"><a href=\"#about\">\u0646\u0628\u0630\u0629 \u0639\u0646\u064a</a><a href=\"#experience\">\u0627\u0644\u062e\u0628\u0631\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u064a\u0629</a><a href=\"#credentials\">\u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a</a><a href=\"#services\">\u0627\u0644\u062e\u062f\u0645\u0627\u062a</a><a href=\"#group-consultations\" data-group-nav>\u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629</a></nav>\n  <span class=\"private-badge\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\"/><path d=\"M8 10V6a4 4 0 0 1 8 0v4\"/></svg>\u0645\u0639\u0627\u064a\u0646\u0629 \u062e\u0627\u0635\u0629</span>\n  <button class=\"menu-button icon-button\" id=\"menuButton\" aria-label=\"\u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u0646\u0642\u0644\" aria-expanded=\"false\" aria-controls=\"mobileNav\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>\n </div>\n <nav id=\"mobileNav\" class=\"mobile-nav\" aria-label=\"\u0627\u0644\u062a\u0646\u0642\u0644 \u0639\u0644\u0649 \u0627\u0644\u062c\u0648\u0627\u0644\" hidden><a href=\"#about\">\u0646\u0628\u0630\u0629 \u0639\u0646\u064a</a><a href=\"#experience\">\u0627\u0644\u062e\u0628\u0631\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u064a\u0629</a><a href=\"#credentials\">\u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a</a><a href=\"#services\">\u0627\u0644\u062e\u062f\u0645\u0627\u062a</a><a href=\"#group-consultations\" data-group-nav>\u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629</a></nav>\n</header>\n<main id=\"main\">\n <section class=\"hero\" id=\"home\">\n  <div class=\"container hero-grid\">\n   <div class=\"hero-copy\" id=\"about\">\n    <p class=\"eyebrow\"><span></span>\u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0648\u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u00b7 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u00b7 \u0627\u0644\u0623\u0639\u0645\u0627\u0644</p>\n    <h1>\u0645\u0647\u0646\u062f \u0639\u0628\u062f\u0627\u0644\u0644\u0647<br><span>\u0633\u0644\u0627\u0645\u0629</span><i aria-hidden=\"true\">.</i></h1>\n    <p class=\"hero-role\" id=\"heroRole\">\u0642\u0627\u0626\u062f \u0623\u0639\u0645\u0627\u0644 \u0648\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0648\u0623\u0639\u0645\u0627\u0644 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0634\u0631\u0643\u0627\u062a</p>\n    <p class=\"hero-bio\" id=\"heroBio\">\u062e\u0628\u0631\u0629 \u062a\u062a\u062c\u0627\u0648\u0632 12 \u0639\u0627\u0645\u0627\u064b \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0648\u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u062a\u0634\u063a\u064a\u0644.</p>\n    <div class=\"hero-actions\"><a class=\"button primary\" href=\"#credentials\">\u0627\u0633\u062a\u0643\u0634\u0641 \u0634\u0647\u0627\u062f\u0627\u062a\u064a <span aria-hidden=\"true\">\u2199</span></a><a class=\"text-link\" href=\"#experience\">\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0631\u062d\u0644\u062a\u064a <span aria-hidden=\"true\">\u2190</span></a></div>\n    <div class=\"hero-note\"><span class=\"note-line\"></span><p>\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0623\u0641\u0631\u0627\u062f.<br><strong>\u0648\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0623\u0639\u0645\u0627\u0644.</strong></p></div>\n   </div>\n   <div class=\"hero-visual\" aria-label=\"\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0647\u0646\u064a\">\n    <div class=\"portrait-card\">\n     <div class=\"profile-card-top\"><span>MAS / PORTFOLIO</span><span class=\"small-star\" aria-hidden=\"true\">\u2733</span></div>\n     <div class=\"portrait-orbit\" aria-hidden=\"true\"></div>\n     <div class=\"portrait-window\"><img src=\"/api/preview/profile\" alt=\"\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0644\u0645\u0647\u0646\u062f \u0633\u0644\u0627\u0645\u0629\" fetchpriority=\"high\"></div>\n     <div class=\"portrait-caption\"><span>\u0634\u063a\u0641 \u0628\u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0648\u062e\u0628\u0631\u0629 \u0641\u064a \u0627\u0644\u062a\u0646\u0641\u064a\u0630</span><strong>\u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0623\u0648\u0644\u0627\u064b\u060c \u0648\u0627\u0644\u0623\u062b\u0631 \u062f\u0627\u0626\u0645\u0627\u064b.</strong></div>\n     <span class=\"vertical-mark\" aria-hidden=\"true\">MUHANNAD SALAMA</span>\n    </div>\n    <div class=\"experience-float\"><strong dir=\"ltr\">12<span>+</span></strong><span>\u0639\u0627\u0645\u064b\u0627 \u0645\u0646 \u0627\u0644\u062e\u0628\u0631\u0629<br>\u0641\u064a \u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0648\u0627\u0644\u0623\u0639\u0645\u0627\u0644</span></div>\n    <a href=\"#credentials\" class=\"qualification-float\"><span class=\"mini-award\" aria-hidden=\"true\">\u2727</span><span><strong>CBP \u2013 Leadership</strong><small>\u0645\u062d\u062a\u0631\u0641 \u0623\u0639\u0645\u0627\u0644 \u0645\u0639\u062a\u0645\u062f \u0641\u064a \u0627\u0644\u0642\u064a\u0627\u062f\u0629</small></span><span aria-hidden=\"true\">\u2196</span></a>\n   </div>\n  </div>\n  <div class=\"container stats-strip\" id=\"stats\"><div><strong dir=\"ltr\">12+</strong><span>\u0633\u0646\u0629 \u062e\u0628\u0631\u0629</span></div><div><strong dir=\"ltr\">5,000+</strong><span>\u0645\u062a\u062f\u0631\u0628</span></div><div><strong dir=\"ltr\">100+</strong><span>\u0628\u0631\u0646\u0627\u0645\u062c \u062a\u062f\u0631\u064a\u0628\u064a</span></div><div><strong>21</strong><span>\u0634\u0647\u0627\u062f\u0629 \u0634\u0643\u0631 \u0648\u062a\u0642\u062f\u064a\u0631</span></div></div>\n </section>\n <section class=\"membership-section section-pad\" id=\"membership\"><div class=\"container\"><div class=\"section-heading\"><div><p class=\"eyebrow section-eyebrow\">\u0627\u0646\u062a\u0645\u0627\u0621 \u0645\u0647\u0646\u064a</p><h2>\u0639\u0636\u0648\u064a\u0629 \u0645\u0648\u062b\u0648\u0642 \u0648\u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629</h2><p class=\"section-description\">\u0628\u0637\u0627\u0642\u062a\u064a \u0627\u0644\u0645\u0647\u0646\u064a\u0629 \u0648\u0631\u0627\u0628\u0637 \u0645\u0644\u0641\u064a \u0641\u064a \u0645\u0646\u0635\u0629 \u0631\u0627\u0626\u062f.</p></div></div><div class=\"membership-content\"></div></div></section>\n <section class=\"experience-section section-pad\" id=\"experience\" aria-labelledby=\"experienceHeading\">\n  <div class=\"container\">\n   <div class=\"section-heading\"><div><p class=\"eyebrow section-eyebrow\">01 / \u0627\u0644\u0645\u0633\u064a\u0631\u0629 \u0627\u0644\u0645\u0647\u0646\u064a\u0629</p><h2 id=\"experienceHeading\">\u062e\u0628\u0631\u0627\u062a \u062a\u0635\u0646\u0639 <em>\u0627\u0644\u0641\u0627\u0631\u0642.</em></h2><p class=\"section-description\">\u0631\u062d\u0644\u0629 \u0645\u0647\u0646\u064a\u0629 \u062a\u062c\u0645\u0639 \u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0648\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0623\u0639\u0645\u0627\u0644.</p></div><span class=\"count-label\"><strong>07</strong> \u0645\u062d\u0637\u0627\u062a \u0645\u0647\u0646\u064a\u0629</span></div>\n   <div class=\"experience-layout\">\n    <aside class=\"experience-intro\"><div class=\"intro-symbol\" aria-hidden=\"true\">\u2197</div><h3 data-edit=\"experienceAsideTitle\">\u062a\u0646\u0648\u0651\u0639 \u0641\u064a \u0627\u0644\u062a\u062c\u0631\u0628\u0629.<br>\u0648\u0636\u0648\u062d \u0641\u064a \u0627\u0644\u0623\u062b\u0631.</h3><p data-edit=\"experienceAsideBody\">\u0627\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u0645\u0633\u064a\u0631\u0629 \u062d\u0633\u0628 \u0627\u0644\u0645\u062c\u0627\u0644\u060c \u0623\u0648 \u062a\u0635\u0641\u0651\u062d\u0647\u0627 \u0645\u0646 \u0627\u0644\u0623\u062d\u062f\u062b \u0625\u0644\u0649 \u0627\u0644\u0623\u0642\u062f\u0645.</p><div class=\"experience-filters\" role=\"group\" aria-label=\"\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u062e\u0628\u0631\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u0645\u062c\u0627\u0644\"><button class=\"active\" data-exp=\"all\" aria-pressed=\"true\">\u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u0628\u0631\u0627\u062a <span>07</span></button><button data-exp=\"training\" aria-pressed=\"false\">\u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0648\u0627\u0644\u06