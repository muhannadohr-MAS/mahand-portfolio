roup\" aria-label=\"\u0646\u0648\u0639 \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a\"><button class=\"active\" data-type=\"all\" aria-pressed=\"true\">\u0627\u0644\u0643\u0644 <span>36</span></button><button data-type=\"qualifications\" aria-pressed=\"false\">\u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a \u0648\u0627\u0644\u062f\u0648\u0631\u0627\u062a <span>10</span></button><button data-type=\"certificates\" aria-pressed=\"false\">\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0642\u062f\u064a\u0631 <span>21</span></button><button data-type=\"documents\" aria-pressed=\"false\">\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062d\u0631 <span>5</span></button></div>\n   <div class=\"search-toolbar\">\n    <div class=\"search-field\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><label class=\"sr-only\" for=\"search\">\u0627\u0628\u062d\u062b \u0628\u0627\u0633\u0645 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0623\u0648 \u0627\u0644\u062c\u0647\u0629</label><input type=\"search\" id=\"search\" placeholder=\"\u0627\u0628\u062d\u062b \u0628\u0627\u0633\u0645 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0623\u0648 \u0627\u0644\u062c\u0647\u0629\u2026\" autocomplete=\"off\"><kbd aria-hidden=\"true\">/</kbd></div>\n    <div class=\"select-field\"><label for=\"yearFilter\">\u0627\u0644\u0633\u0646\u0629</label><select id=\"yearFilter\"><option value=\"all\">\u062c\u0645\u064a\u0639 \u0627\u0644\u0633\u0646\u0648\u0627\u062a</option></select></div>\n    <div class=\"select-field\"><label for=\"sortOrder\">\u0627\u0644\u062a\u0631\u062a\u064a\u0628</label><select id=\"sortOrder\"><option value=\"original\">\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0645\u0644\u0641</option><option value=\"newest\">\u0627\u0644\u0623\u062d\u062f\u062b \u0623\u0648\u0644\u0627\u064b</option><option value=\"oldest\">\u0627\u0644\u0623\u0642\u062f\u0645 \u0623\u0648\u0644\u0627\u064b</option></select></div>\n   </div>\n   <div class=\"results-line\"><p id=\"resultsCount\" role=\"status\">\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a\u2026</p><button id=\"resetFilters\" class=\"reset-filters\" hidden>\u0645\u0633\u062d \u0627\u0644\u0641\u0644\u0627\u062a\u0631 <span aria-hidden=\"true\">\u00d7</span></button><span class=\"viewer-hint\" data-edit=\"credentialHint\">\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 <span aria-hidden=\"true\">\u2196</span></span></div>\n   <div class=\"credentials-grid\" id=\"credentialsGrid\"></div>\n   <div class=\"empty-state\" id=\"emptyState\" hidden><span aria-hidden=\"true\">\u2315</span><h3>\u0644\u0645 \u0646\u062c\u062f \u0646\u062a\u0627\u0626\u062c \u0645\u0637\u0627\u0628\u0642\u0629</h3><p>\u062c\u0631\u0651\u0628 \u0643\u0644\u0645\u0629 \u0623\u0642\u0635\u0631\u060c \u0623\u0648 \u0627\u0628\u062d\u062b \u0628\u0627\u0633\u0645 \u0627\u0644\u062c\u0647\u0629\u060c \u0623\u0648 \u063a\u064a\u0651\u0631 \u0627\u0644\u0641\u0644\u0627\u062a\u0631.</p><button id=\"emptyReset\" class=\"button primary\">\u0639\u0631\u0636 \u062c\u0645\u064a\u0639 \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a</button></div>\n   <div class=\"load-more-wrap\" id=\"loadMoreWrap\" hidden><p id=\"shownCount\"></p><button id=\"loadMore\" class=\"button secondary\">\u0639\u0631\u0636 \u0627\u0644\u0645\u0632\u064a\u062f <span aria-hidden=\"true\">\u2193</span></button></div>\n   <p class=\"source-note\" data-edit=\"credentialNote\">\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a \u0645\u0639\u0627\u064a\u0646\u0627\u062a \u0644\u0644\u0639\u0631\u0636 \u0641\u0642\u0637. \u0627\u0644\u062a\u0648\u0627\u0631\u064a\u062e \u0628\u062d\u0633\u0628 \u0627\u0644\